#!/bin/bash
#PBS -N rrfs_enkf_ioda_bufr_spinup_%CYC%
#PBS -j oe
#PBS -S /bin/bash
#PBS -q %QUEUE%
#PBS -A %PROJ%-%PROJENVIR%
#PBS -l walltime=00:30:00
#PBS -l place=vscatter:shared,select=1:ncpus=1:mem=20G
#PBS -l debug=true
#SBATCH --job-name=rrfs_enkf_ioda_bufr_spinup_%CYC%
#SBATCH --account=%PROJ%
#SBATCH --qos=%QUEUE%
#SBATCH --partition=%PARTITION:u1-compute%
#SBATCH --time=00:30:00
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --mem=20G
#SBATCH --output=%ECF_JOBOUT%

model=rrfs
export MACHINE=%MACHINE:WCOSS2%
export cyc="%CYC%"
%include <head.h>
%include <envir-p1.h>
############################################################
# Load modules
############################################################
# Cray modules for WCOSS2; on Ursa, head.h loads modulefiles/run_ursa.lua instead
if [ "${MACHINE}" = "WCOSS2" ]; then
module load intel/${intel_ver}
module load craype/${craype_ver}
module load ve/rrfs/${rrfs_pythonve_ver}
module load cray-mpich/${cray_mpich_ver}
module load cray-pals/${cray_pals_ver}
module load hdf5-D/${hdf5_ver}
module load netcdf-D/${netcdf_ver}
module load pnetcdf-D/${pnetcdf_ver}
module load bacio/${bacio_ver}
module load w3emc/${w3emc_ver}
module load sp/${sp_ver}
module load ip/${ip_ver}
module load nemsio/${nemsio_ver}
module load ncdiag-A/${ncdiag_ver}
module load libjpeg/${libjpeg_ver}
module load crtm/${crtm_ver}
module load udunits/${udunits_ver}
module load gsl/${gsl_ver}
module load nco/${nco_ver}
fi

# The offline_domain_check*/offline_vad_thinning scripts import cartopy and shapely, which the
# python environment run_ursa.lua sets up does not carry. CARTOPY_DATA_DIR points at local
# Natural Earth shapefiles because compute nodes have no internet to fetch them. Same modules as
# the Rocoto workflow's modulefiles/tasks/ursa/run_ioda_bufr.local.lua.
if [ "${MACHINE}" = "URSA" ]; then
module load py-shapely/2.0.6
module load py-cartopy/0.24.1
export CARTOPY_DATA_DIR=${CARTOPY_DATA_DIR:-/scratch3/NCEPDEV/nems/role.epic/ursa/UFS_SRW_data/develop/NaturalEarth}
fi

module list
export WGF="%WGF%"
export CYCLE_TYPE="%CYCLE_TYPE%"
############################################################
# CALL executable job script here
############################################################
${HOMErrfs}/jobs/JRRFS_IODA_BUFR

%include <tail.h>

%manual
%end
