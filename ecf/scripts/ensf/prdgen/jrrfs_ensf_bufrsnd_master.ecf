#!/bin/bash
#PBS -N rrfs_ensf_bufrsnd_mem@ensf_bufrsnd_fhr@_%CYC%
#PBS -j oe
#PBS -S /bin/bash
#PBS -q %QUEUE%
#PBS -A %PROJ%-%PROJENVIR%
#PBS -l walltime=03:10:00
#PBS -l place=vscatter:excl,select=2:ncpus=96:mem=500G
#PBS -l debug=true
#SBATCH --job-name=rrfs_ensf_bufrsnd_mem@ensf_bufrsnd_fhr@_%CYC%
#SBATCH --account=%PROJ%
#SBATCH --qos=%QUEUE%
#SBATCH --partition=%PARTITION:u1-compute%
#SBATCH --time=03:10:00
#SBATCH --nodes=2
#SBATCH --exclusive
#SBATCH --mem=0
#SBATCH --output=%ECF_JOBOUT%

model=rrfs
export MACHINE=%MACHINE:WCOSS2%
export cyc="%CYC%"
%include <head.h>
%include <envir-p1.h>
############################################################
# Load modules
############################################################
# Cray modules for WCOSS2; on Ursa, head.h loads modulefiles/run_ursa.lua instead
if [ "${MACHINE}" = "WCOSS2" ]; then
module load intel/${intel_ver}
module load craype/${craype_ver}
module load ve/rrfs/${rrfs_pythonve_ver}
module load cray-mpich/${cray_mpich_ver}
module load cray-pals/${cray_pals_ver}
module load hdf5-D/${hdf5_ver}
module load netcdf-D/${netcdf_ver}
module load pnetcdf-D/${pnetcdf_ver}
module load gempak/${gempak_ver}
fi

module list
export WGF="%WGF%"
export MEMBER_NAME="%MEMBER_NAME%"
############################################################
# CALL executable job script here
############################################################
${HOMErrfs}/jobs/JRRFS_BUFRSND

%include <tail.h>

%manual
%end
