#!/bin/bash
#PBS -N rrfs_ensf_post_manager_%CYC%
#PBS -j oe
#PBS -S /bin/bash
#PBS -q %QUEUE%
#PBS -A %PROJ%-%PROJENVIR%
#PBS -l walltime=03:10:00
#PBS -l place=shared,select=1:ncpus=1:mem=10GB
#PBS -l debug=true
#SBATCH --job-name=rrfs_ensf_post_manager_%CYC%
#SBATCH --account=%PROJ%
#SBATCH --qos=%QUEUE%
#SBATCH --partition=%PARTITION:u1-compute%
#SBATCH --time=03:10:00
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --mem=10G
#SBATCH --output=%ECF_JOBOUT%

export model=rrfs
export MACHINE=%MACHINE:WCOSS2%

%include <head.h>
%include <envir-p1.h>

export cyc="%CYC%"
export WGF="%WGF%"

############################################################
# CALL executable job script here
############################################################
${HOMErrfs}/jobs/JRRFS_POST_MANAGER

%include <tail.h>

%manual
%end
