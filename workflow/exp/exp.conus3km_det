#!/usr/bin/env bash
# Aloha! This file is to setup some top level experiment options
#
# shellcheck disable=all
export NET=rrfs                   # rrfs, rtma, 
export MESH_NAME=conus3km         # conus12km, conus3km, na12km, etc
export WGF="det"   # working group function = "det", "enkf", "ens", "firewx"
export VERSION=$(cat ./VERSION)
export EXP_NAME=RRFSv2
export TAG=rrfsv2
export OPSROOT=/scratch3/BMC/wrfruc/gge/OPSROOT/${EXP_NAME}
#export OPSROOT=/scratch3/BMC/rtwrfruc/RRFSv2X/NCO_dirs/${EXP_NAME}
export EXPDIR=${OPSROOT}/exp/${NET}${WGF}
export COMROOT=${OPSROOT}/com      # task input and output data as well as logs
export DATAROOT=${OPSROOT}/stmp    # task workdirs ($DATA) which to be removed immediately upon task completion unless KEEPDATA=YES
#
export REALTIME=false
export ZETA_LEVELS="L60.txt"
export USE_MERRA2=false  # false: default GOCART aerosol climatology; true: MERRA2 aerosol climatology
#
export DO_IODA=true
export DO_JEDI=true
export SNUDGETYPES="GGG" # G=gsd_update_soiltq from GSI; P=2022 J Hydro paper; chars=SoilT,SnowT,SoilQ
export DO_NONVAR_CLOUD_ANA=true
export COLDSTART_CYCS_DO_DA=true
export DO_CHEMISTRY=false
export DO_CLEAN=true
export DO_BLENDING=false
export BLENDING_CYCS="00 12"    # cycle to blend large and small scale .e.g. GFS/MPAS forecast
export HYB_WGT_ENS=0.5
export HYB_WGT_STATIC=0.5
export HYB_ENS_TYPE=1      # 1.rrfs; 2.interpolated GEFS/GDAS; 0.TBD on the fly (rrfs->GDAS->3DVAR)
export HYB_ENS_PATH=""     # if empty, the workflow will try to find ensembles automatically
export DO_RADAR_REF=true  # does not work for 3DVar, only EnVar or GETKF
export RADARREFL_TIMELEVEL="00"  # 00 15 30 45 min
export SAT_USELIST=""  # check config.base on how to set up this variable
export ENS_SIZE=30
export ENS_BEC_LOOK_BACK_HRS=1  # define the hours going back for ensemble forecast files for the ensemble BEC
export DO_HOFX=false
export HOFX_FHRS="000 001 012"
export DO_SPPT=false
export DO_SFC_UPDATE=true # do sfc update at cold start cycs
export SFC_UPDATE_LOOK_BACK_HRS=1  # hours going back to look for surface update source files (mpasout)

export STATIC_BEC_MODEL="GSIBEC" # the static bec model, GSIBEC and BUMPBEC
export GSIBEC_X=40 #GSIBEC_X * GSIBEC_Y should match the number of MPI tasks
export GSIBEC_Y=20

export DO_CYC=true
export CYC_INTERVAL=1
for i in {0..23};    do arr[$i]="03"; done # 3hr fcst
for i in {0..23..3}; do arr[$i]="12"; done # 12hr fcst every 3hrs
for i in {0..23..12}; do arr[$i]="72"; done # 72hr fcst every 12hrs
export FCST_LEN_HRS_CYCLES="${arr[*]}"
export HISTORY_INTERVAL=1
export DIAG_INTERVAL=1
#export DIAG_TIMELEVELS="@dt@ 1-999"  # @dt@ will be replaced with the actual vaule during the setup process
export MPASOUT_TIMELEVELS='0 1 2 3 15 27'
export POST_GROUP_TOT_NUM=3 # num of groups, the final group absorbs leftovers, the first group contains the extra f000h file

export IC_OFFSET=3
export LBC_OFFSET=6
export LBC_LENGTH=84
export LBC_INTERVAL=1
export LBC_UNGRIB_GROUP_TOTAL_NUM=3
export LBC_GROUP_TOTAL_NUM=6
export PREP_LBC_LOOK_BACK_HRS=11 # define the hours going back for prep_lbc to find lbc files

export RETRO_PERIOD="2024050610-2024051300"
export LBC_CYCS="00 12"  # evenly divide 24 hours, e.g., "00 12", "00 06 12 18", etc
export COLDSTART_CYCS="03 15"   # cycles to cold start from external models
export SST_UPDATE_CYCS="00 12"
export DO_SPINUP=true
export PRODSWITCH_CYCS="09 21"

export KEEPDATA=YES
export DO_PYDAMONITOR=true
export DO_GRAPHICS=true
export GRAPHICS_TILES="full NE NC NW SE SC SW EastCO"
export GRAPHICS_MODEL=${TAG}   # Model Name in the plots
if [[ "${REALTIME^^}" == "TRUE" ]]; then
  export GRAPHICS_ZIP=true
  export DO_ARCHIVE=true
  export ARCHIVE_HPSSDIR="/5year/BMC/wrfruc/${TAG}"
  export ARCHIVE_INTERVAL=1  # run the archive task every several hours
  export ARCHIVE_COM1_SPEC='{"include":"ioda*, jedivar, nonvar*, fcst, upp, pyDAmonitor, nclprd, graphics", "exclude":""}'  # use " inside and ' outside
  export ARCHIVE_STMP=''  # eg. 'fcst,mpassit'  # archive files under the given task umbrella directories
  export ARCHIVE_STMP_INTERVAL='1'  # ARCHIVE_STMP_INTERVAL must divide ARCHIVE_INTERVAL evenly
  export MAXTRIES=1
  export STMP_RETENTION_CYCS=18
  export COM_RETENTION_CYCS='{"default": 96, "lbc,fcst": 48, "upp,nclprd,pyDAmonitor": 960}'  # use " inside and ' outside
  export CYCLETHROTTLE=3600
  export CYCLELIFESPAN=2
  export STARTTIME_UNGRIB_IC="00:05:00"
  export STARTTIME_UNGRIB_LBC="00:05:00"
  export STARTTIME_IC="00:10:00"
  export STARTTIME_LBC="00:10:00"
  export STARTTIME_IODA_BUFR="00:40:00"
  export STARTTIME_NONVAR_REFLOBS="00:40:00"
  export STARTTIME_NONVAR_BUFROBS="00:40:00"
  export STARTTIME_IODA_MRMS_REFL="00:40:00"
  export STARTTIME_JEDIVAR="00:40:00"
  export STARTTIME_FCST="00:10:00"
  export STARTTIME_MPASSIT="00:15:00"
  export STARTTIME_UPP="00:15:00"
  export STARTTIME_PREP_IC="02:00:00"
  export STARTTIME_PREP_LBC="00:15:00"
  export MORE_XML_ENTITIES=true
  export USE_THE_LATEST_SATBIAS=false
  export IC_EXTRN_MDL_FILENAME_PATTERN="gfs.@Y@m@d/@H/atmos/gfs.t@Hz.pgrb2.0p25.f^HHH^"
  export IC_EXTRN_MDL_FILENAME_PATTERN_B="gfs.@Y@m@d/@H/atmos/gfs.t@Hz.pgrb2b.0p25.f^HHH^"
else  # ========== for retros ==========
  #export DO_ARCHIVE=true
  #export ARCHIVE_HPSSDIR="/5year/BMC/wrfruc/${USER}/${EXP_NAME}"
  #export ARCHIVE_INTERVAL=1  # run the archive task every several hours
  #export ARCHIVE_COM1_SPEC='{"include":"ioda*, jedivar, nonvar*, fcst, upp, pyDAmonitor, nclprd, graphics", "exclude":""}'  # use " inside and ' outside
  #export ARCHIVE_STMP=''  # eg. 'fcst,mpassit'  # archive files under the given task umbrella directories
  #export ARCHIVE_STMP_INTERVAL='1'  # ARCHIVE_STMP_INTERVAL must divide ARCHIVE_INTERVAL evenly

  export IC_EXTRN_MDL_FILENAME_PATTERN="gfs.@Y@m@d/@H/gfs.t@Hz.pgrb2.0p25.f^HHH^"
  export IC_EXTRN_MDL_FILENAME_PATTERN_B="gfs.@Y@m@d/@H/gfs.t@Hz.pgrb2b.0p25.f^HHH^"
fi
#
# local.setup: setup some local options specific to a platform or an experiment
#
# set up IC, LBC sources and A/Q/P/R information
export IC_EXTRN_MDL_NAME="GFS"
export LBC_EXTRN_MDL_NAME=${IC_EXTRN_MDL_NAME}
export LBC_EXTRN_MDL_FILENAME_PATTERN=${IC_EXTRN_MDL_FILENAME_PATTERN}
export LBC_EXTRN_MDL_FILENAME_PATTERN_B=${IC_EXTRN_MDL_FILENAME_PATTERN_B}
case ${MACHINE} in
  "hera")
    export IC_EXTRN_MDL_BASEDIR="/scratch4/BMC/rtrr/RRFS2_RETRO_DATA/May2024/GFS"
    export LBC_EXTRN_MDL_BASEDIR=${IC_EXTRN_MDL_BASEDIR}
    export OBSPATH="/scratch4/BMC/rtrr/RRFS2_RETRO_DATA/May2024/obs_rap"
    export OBSPATH_NSSLMOSAIC="/scratch4/BMC/rtrr/RRFS2_RETRO_DATA/May2024/reflectivity"
    export OBSPATH_AIRNOW="/scratch4/BMC/rtrr/RRFS2_RETRO_DATA/May2024/airnow"
    export ACCOUNT="wrfruc"
    export QUEUE="batch"
    export PARTITION="hera"
    export NODES_IC="<nodes>40:ppn=40</nodes>"
    export NODES_LBC="<nodes>40:ppn=40</nodes>"
    export NODES_FCST="<nodes>40:ppn=40</nodes>"
    export NODES_MPASSIT="<nodes>4:ppn=20</nodes>"
    export NODES_UPP="<nodes>4:ppn=20</nodes>"
    export NODES_JEDIVAR="<nodes>80:ppn=10</nodes>"
    export NODES_MPAS_BLEND="<nodes>40:ppn=40</nodes>"
    export WALLTIME_FCST="2:00:00"
    export WALLTIME_MPASSIT="2:00:00"
    export WALLTIME_UPP="2:00:00"
    export WALLTIME_JEDIVAR="00:30:00"
    ;;
  "orion"|"hercules")
    export IC_EXTRN_MDL_BASEDIR="/work2/noaa/wrfruc/RRFS2_RETRO_DATA/May2024/GFS"
    export LBC_EXTRN_MDL_BASEDIR=${IC_EXTRN_MDL_BASEDIR}
    export OBSPATH="/work2/noaa/wrfruc/RRFS2_RETRO_DATA/May2024/obs_rap"
    export OBSPATH_NSSLMOSAIC="/work2/noaa/wrfruc/RRFS2_RETRO_DATA/May2024/reflectivity"
    export OBSPATH_AIRNOW="/work2/noaa/wrfruc/RRFS2_RETRO_DATA/May2024/airnow"
    export ACCOUNT="wrfruc"
    export QUEUE="batch"
    export PARTITION=${MACHINE}
    export CLUSTER=""
    export NODES_IC="<nodes>40:ppn=40</nodes>"
    export NODES_LBC="<nodes>40:ppn=40</nodes>"
    export NODES_FCST="<nodes>40:ppn=40</nodes>"
    export NODES_MPASSIT="<nodes>4:ppn=20</nodes>"
    export NODES_UPP="<nodes>4:ppn=20</nodes>"
    export NODES_JEDIVAR="<nodes>80:ppn=10</nodes>"
    export NODES_MPAS_BLEND="<nodes>40:ppn=40</nodes>"
    export WALLTIME_FCST="2:00:00"
    export WALLTIME_MPASSIT="2:00:00"
    export WALLTIME_UPP="2:00:00"
    export WALLTIME_JEDIVAR="00:30:00"
    if [[ "${MACHINE}" == "hercules" ]]; then
      export NODES_IC="<nodes>20:ppn=80</nodes>"
      export NODES_LBC="<nodes>20:ppn=80</nodes>"
      export NODES_FCST="<nodes>20:ppn=80</nodes>"
      export NODES_MPASSIT="<nodes>2:ppn=80</nodes>"
      export NODES_UPP="<nodes>1:ppn=80</nodes>"
      export NODES_JEDIVAR="<nodes>10:ppn=80</nodes>"
      export NODES_MPAS_BLEND="<nodes>20:ppn=80</nodes>"
    fi
    ;;
  "ursa")
    if [[ "${REALTIME^^}" == "TRUE" ]]; then
      export IC_EXTRN_MDL_BASEDIR="/public/data/grids/gfs/ncep"
      export LBC_EXTRN_MDL_BASEDIR=${IC_EXTRN_MDL_BASEDIR}
      export OBSPATH="/public/data/grids/rap/obs"
      export OBSPATH_NSSLMOSAIC="/public/data/radar/mrms"
      #export SFC_UPDATE_SOURCE_DIR=/scratch3/BMC/rtwrfruc/RRFSv2X/NCO_dirs/MPAS_RAP
      export NSST_SOURCE_DIR=/public/data/grids/ncep/sst/0p083deg/grib2
      export LAKE_SOURCE_DIR=/public/data/grids/rrfs_a
      export ACCOUNT="rtwrfruc"
      export QUEUE="hpq"   # "windfall"
    else
      export IC_EXTRN_MDL_BASEDIR="/scratch4/BMC/rtrr/RRFS2_RETRO_DATA/May2024/GFS"
      export LBC_EXTRN_MDL_BASEDIR=${IC_EXTRN_MDL_BASEDIR}
      export OBSPATH="/scratch4/BMC/rtrr/RRFS2_RETRO_DATA/May2024/obs_rap"
      export OBSPATH_NSSLMOSAIC="/scratch4/BMC/rtrr/RRFS2_RETRO_DATA/May2024/reflectivity"
      export OBSPATH_AIRNOW="/scratch4/BMC/rtrr/RRFS2_RETRO_DATA/May2024/airnow"
      export ACCOUNT="wrfruc"
      export QUEUE="batch"
    fi
    export PARTITION="u1-compute"
    export NODES_IC="<nodes>10:ppn=160</nodes>"
    export NODES_LBC="<nodes>10:ppn=160</nodes>"
    export NODES_FCST="<nodes>10:ppn=160</nodes>"
    export NODES_MPASSIT="<nodes>1:ppn=160</nodes>"
    export NODES_UPP="<nodes>1:ppn=80</nodes>"
    export NODES_JEDIVAR="<nodes>20:ppn=40</nodes>"
    export NODES_MPAS_BLEND="<nodes>10:ppn=160</nodes>"
    ;;
  "gaeac6")
    if [[ "${REALTIME^^}" == "TRUE" ]]; then
      export IC_EXTRN_MDL_BASEDIR="/gpfs/f6/gsl-data-depot/world-shared/data/grids/gfs"
      export LBC_EXTRN_MDL_BASEDIR=${IC_EXTRN_MDL_BASEDIR}
      export OBSPATH="/gpfs/f6/gsl-data-depot/world-shared/data/grids/rap/obs"
      export OBSPATH_NSSLMOSAIC="/gpfs/f6/gsl-data-depot/world-shared/data/radar/mrms"
      #export SFC_UPDATE_SOURCE_DIR=/scratch3/BMC/rtwrfruc/RRFSv2X/NCO_dirs/MPAS_RAP
      export NSST_SOURCE_DIR=/gpfs/f6/gsl-data-depot/world-shared/data/grids/ncep/sst/0p083deg/grib2
      export LAKE_SOURCE_DIR=/gpfs/f6/gsl-data-depot/world-shared/data/grids/rrfs_a
    else
      export IC_EXTRN_MDL_BASEDIR="/gpfs/f6/bil-fire10-oar/world-shared/RRFS2_RETRO_DATA/May2024/GFS"
      export LBC_EXTRN_MDL_BASEDIR=${IC_EXTRN_MDL_BASEDIR}
      export OBSPATH="/gpfs/f6/bil-fire10-oar/world-shared/RRFS2_RETRO_DATA/May2024/obs_rap"
      export OBSPATH_NSSLMOSAIC="/gpfs/f6/bil-fire10-oar/world-shared/RRFS2_RETRO_DATA/May2024/reflectivity"
      export OBSPATH_AIRNOW="/gpfs/f6/bil-fire10-oar/world-shared/RRFS2_RETRO_DATA/May2024/airnow"
      export NSST_SOURCE_DIR="/gpfs/f6/bil-fire10-oar/world-shared/RRFS2_RETRO_DATA/May2024/NSST"
    fi
    export ACCOUNT="wrfruc"
    export QUEUE="normal"
    export PARTITION="batch"
    export CLUSTER="c6"
    export NODES_PREP_IC="<nodes>1:ppn=10</nodes>"
    export NODES_IC="<nodes>2:ppn=192</nodes>"
    export NODES_LBC="<nodes>2:ppn=192</nodes>"
    export NODES_FCST="<nodes>4:ppn=192</nodes>"
    export NODES_FCST_L="<nodes>4:ppn=192</nodes>"
    export NODES_FCST_XL="<nodes>10:ppn=192</nodes>"
    export NODES_MPASSIT="<nodes>1:ppn=160</nodes>"
    export NODES_UPP="<nodes>1:ppn=80</nodes>"
    export NODES_JEDIVAR="<nodes>20:ppn=40</nodes>"
    export NODES_MPAS_BLEND="<nodes>10:ppn=160</nodes>"
    export NODES_IODA_MRMS_REFL="<nodes>1:ppn=40</nodes>"
    export WALLTIME_FCST="1:00:00"
    export WALLTIME_FCST_L="1:30:00"
    export WALLTIME_FCST_XL="5:30:00"
    export WALLTIME_SAVE_FCST="0:30:00"
    export WALLTIME_MPASSIT="3:00:00"
    export WALLTIME_UPP="2:00:00"
    export WALLTIME_JEDIVAR="00:25:00"
    ;;
  "gaeac7")
    export IC_EXTRN_MDL_BASEDIR="/gpfs/f7/wrfruc/world-shared/RRFS2_RETRO_DATA/May2024/GFS"
    export LBC_EXTRN_MDL_BASEDIR=${IC_EXTRN_MDL_BASEDIR}
    export OBSPATH="/gpfs/f7/wrfruc/world-shared/RRFS2_RETRO_DATA/May2024/obs_rap"
    export OBSPATH_NSSLMOSAIC="/gpfs/f7/wrfruc/world-shared/RRFS2_RETRO_DATA/May2024/reflectivity"
    export OBSPATH_AIRNOW="/gpfs/f7/wrfruc/world-shared/RRFS2_RETRO_DATA/May2024/airnow"
    export ACCOUNT="bil-fire10-oar"
    export QUEUE="normal"
    export PARTITION="batch"
    export CLUSTER="c7"
    export NODES_PREP_IC="<nodes>1:ppn=10</nodes>"
    export NODES_IC="<nodes>1:ppn=384</nodes>"
    export NODES_LBC="<nodes>1:ppn=384</nodes>"
    export NODES_FCST="<nodes>2:ppn=384</nodes>"
    export NODES_FCST_L="<nodes>2:ppn=384</nodes>"
    export NODES_FCST_XL="<nodes>5:ppn=384</nodes>"
    export NODES_MPASSIT="<nodes>1:ppn=160</nodes>"
    export NODES_UPP="<nodes>1:ppn=80</nodes>"
    export NODES_JEDIVAR="<nodes>8:ppn=100</nodes>"
    export NODES_MPAS_BLEND="<nodes>10:ppn=160</nodes>"
    export NODES_IODA_MRMS_REFL="<nodes>1:ppn=40</nodes>"
    export WALLTIME_FCST="1:00:00"
    export WALLTIME_FCST_L="1:30:00"
    export WALLTIME_FCST_XL="5:30:00"
    export WALLTIME_SAVE_FCST="0:30:00"
    export WALLTIME_MPASSIT="3:00:00"
    export WALLTIME_UPP="2:00:00"
    export WALLTIME_JEDIVAR="00:25:00"
    ;;
  "wcoss2")
    export IC_EXTRN_MDL_BASEDIR="/lfs/h2/emc/lam/noscrub/RRFS2_RETRO_DATA/May2024/GFS"
    export LBC_EXTRN_MDL_BASEDIR=${IC_EXTRN_MDL_BASEDIR}
    export OBSPATH="/lfs/h2/emc/lam/noscrub/RRFS2_RETRO_DATA/May2024/obs_rap"
    export OBSPATH_NSSLMOSAIC="/lfs/h2/emc/lam/noscrub/RRFS2_RETRO_DATA/May2024/reflectivity"
    export OBSPATH_AIRNOW="/lfs/h2/emc/lam/noscrub/RRFS2_RETRO_DATA/May2024/airnow"
    export ACCOUNT="RRFS-DEV"
    export QUEUE="dev"
    export PARTITION=""
    export CLUSTER=""
    ;;
  *)
    echo "!!! unsupported platform:'${MACHINE}'!!!"
    ;;
esac
