#!/usr/bin/python3
# /usr/bin/python3 (3.9), not env python3: the ecflow module's Python bindings are built for 3.9
# and crash under the spack-stack 3.11 that is often first on PATH on Ursa. On WCOSS2 the system
# python3 is older than the bindings; load the python module of their version and run
# "python3 rrfsstat" instead.
"""Show the state of the RRFS ecflow suite as text, in the spirit of rocotostat.

ecflow keeps the workflow state on the server, so this asks the server and prints it. By default
it prints one line per cycle (a rollup); --tasks prints one line per task, like rocotostat does.

  rrfsstat                          rollup of every released cycle
  rrfsstat -t                       every task, most interesting states first
  rrfsstat -w                       every task in workflow order, grouped by cycle
  rrfsstat -p                       every task the configuration will run, and its state
  rrfsstat --set-aside              also list the tasks the configuration switched off
  rrfsstat --report                 write stat, RUN, DEAD and TASKS, like the Rocoto stat script
  rrfsstat -t -s aborted,active     only these states
  rrfsstat -c 03z                   only the 03z cycle
  rrfsstat -t -o status.txt         write to a file instead of the terminal
  rrfsstat -l 60                    refresh every 60 seconds until interrupted

The server to talk to comes from --host/--port, else ECF_HOST/ECF_PORT, else the host in
ecf/defs/retro/config.sh and port 1500 + your uid on Ursa (what the ecflow module sets) or
2000 + your uid on WCOSS2 (what NCO assigns). So it works with or without the module loaded; pass
--port only if your server runs on another port.

States are ecFlow's: queued (ready for ecFlow to submit), submitted (accepted by the batch
scheduler and waiting to run), active (running), complete, aborted, suspended, unknown.
"aborted" is the one to look at; it means the job failed. "suspended" is a node someone held.
Task listings give the job log of each aborted or running task on the line below it.
--workflow prints them in the words rocotostat uses (RUNNING, DONE, FAILED and so on).

Tasks the configuration switched off are left out of every listing: they are in the definition
only so that ecflow has something to call complete, and a simplified retro has thousands of them.
The --set-aside option includes them, marked SET-ASIDE. --plan adds a census by task type to the
listing and covers the days the retro has not reached yet, which is how to tell whether a
simplified retro has been cut down the way it was meant to be.
"""

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import time

try:
    import ecflow
except ImportError:
    sys.exit("rrfsstat: cannot import ecflow. Load the ecflow module, and on WCOSS2 also the python\n"
             "  module matching its bindings, then run it as: python3 rrfsstat ...")

# most interesting first, so the states worth acting on sort to the top of a task listing
STATE_ORDER = ["aborted", "active", "submitted", "queued", "unknown", "complete", "suspended"]
# rocotostat-style words for --workflow, so the listing reads like the Rocoto one
STATE_WORD = {"aborted": "FAILED", "active": "RUNNING", "submitted": "BATCH QUEUED",
              "queued": "READY", "complete": "DONE", "suspended": "HELD", "unknown": "UNKNOWN"}
DEFAULT_SUITE = "para"
# task listings give the job log path of tasks in these states, on a line below the task
LOG_STATES = ("aborted", "active")


def settings_from_config():
    """Fall back to ecf/defs/retro/config.sh so this works without any environment set up."""
    here = os.path.dirname(os.path.realpath(__file__))
    defs = os.path.join(here, "..", "..", "ecf", "defs")
    host = port = suite = None
    try:
        with open(os.path.join(defs, "retro/config.sh")) as f:
            text = f.read()
    except OSError:
        return host, port, suite
    m = re.search(r"^ECFLOW_HOST=\$\{ECFLOW_HOST:-([^}]+)\}", text, re.M)
    if m:
        host = m.group(1).strip()
    m = re.search(r"^RRFS_SUITE=\$\{RRFS_SUITE:-([^}]+)\}", text, re.M)
    if m and "$" not in m.group(1):
        suite = m.group(1).strip()
    if suite is None:
        m = re.search(r"^EXPT_ID=\$\{EXPT_ID:-([^}]+)\}", text, re.M)
        if m:
            suite = m.group(1).strip()
    return host, port, suite


def default_port():
    """Each user's own port: 1500 + uid from Ursa's ecflow module, 2000 + uid assigned by NCO on WCOSS2."""
    return str((2000 if os.path.isdir("/apps/ops/prod") else 1500) + os.getuid())


def tasks_under(node):
    for child in node.nodes:
        if isinstance(child, ecflow.Task):
            yield child
        else:
            yield from tasks_under(child)


def suspended_ancestor(defs, path):
    """True if the task or anything above it is suspended (ecflow does not inherit the flag)."""
    parts = path.split("/")
    for i in range(2, len(parts) + 1):
        node = defs.find_abs_node("/".join(parts[:i]))
        if node is not None and node.is_suspended():
            return True
    return False


def job_log(task):
    """The job output file of the task's current try (ECF_JOBOUT), or "" if it has not run."""
    if int(task.get_try_no()) < 1:
        return ""
    gen = ecflow.VariableList()
    task.get_generated_variables(gen)
    return next((v.value() for v in gen if v.name() == "ECF_JOBOUT"), "")


def family_pdy(node):
    for v in node.variables:
        if v.name() == "PDY":
            return v.value()
    return None


def collect(defs, suite, cycle_filter, state_filter, show_all=False):
    """One record per task: cycle date, cycle hour, path, state, try number, last change."""
    rows = []
    primary = defs.find_abs_node(f"/{suite}/primary")
    if primary is None:
        sys.exit(f"ERROR: /{suite}/primary not found on the server")
    for day_fam in primary.nodes:
        pdy = family_pdy(day_fam)
        if pdy is None and not show_all:
            continue    # a day family the retro has not released yet
        pdy = pdy or "-"
        for task in tasks_under(day_fam):
            path = task.get_abs_node_path()
            m = re.search(r"/(\d\dz)/", path)
            cyc = m.group(1) if m else "-"
            if cycle_filter and cyc not in cycle_filter:
                continue
            node_state = str(task.get_state())
            state = node_state
            # show held work as suspended, but never hide a failure: an aborted task below a
            # suspended family still makes that family roll up as aborted
            if state != "aborted" and suspended_ancestor(defs, path):
                state = "suspended"
            if state_filter and state not in state_filter:
                continue
            short = path.split("/rrfs/", 1)[-1].split("/", 1)[-1] if "/rrfs/" in path else path
            # a task the definition starts complete never runs: either switched off by the
            # generator (defstatus complete) or held complete by hand (RETRO_SET_ASIDE)
            aside = (str(task.get_defstatus()) == "complete"
                     or any(v.name() == "RETRO_SET_ASIDE" for v in task.variables))
            rows.append({
                "aside": aside,
                "pdy": pdy,
                "cycle": cyc,
                "task": short,
                "state": state,
                # Keep the task state separate from a hold inherited from a parent node.
                "node_state": node_state,
                "held": state == "suspended" and node_state != "suspended",
                "try": task.get_try_no(),
                "changed": str(task.get_state_change_time()).replace("T", " ")[5:],
                # only where someone would open it, since the driver lists the suite every minute
                "log": job_log(task) if node_state in LOG_STATES else "",
            })
    return rows


def slurm_jobs():
    """Running and pending job names from squeue (Ursa) or qstat (WCOSS2), to show alongside the
    ecflow state, as {name: (state, elapsed)} with Slurm's state words."""
    user = os.environ.get("USER", "")
    try:
        if shutil.which("squeue"):
            out = subprocess.run(["squeue", "-u", user, "-h", "-o", "%j|%T|%M"],
                                 capture_output=True, text=True, timeout=20).stdout
            return {p[0]: (p[1], p[2]) for p in (l.split("|") for l in out.splitlines()) if len(p) == 3}
        ids = subprocess.run(["qselect", "-u", user], capture_output=True, text=True,
                             timeout=20).stdout.split()
        if not ids:
            return {}
        out = subprocess.run(["qstat", "-f", "-F", "json"] + ids, capture_output=True, text=True,
                             timeout=60).stdout
        pbs_state = {"R": "RUNNING", "E": "RUNNING", "Q": "PENDING", "H": "HELD", "W": "PENDING"}
        jobs = {}
        for j in json.loads(out).get("Jobs", {}).values():
            elapsed = j.get("resources_used", {}).get("walltime", "")
            jobs[j.get("Job_Name", "")] = (pbs_state.get(j.get("job_state"), j.get("job_state", "")), elapsed)
        return jobs
    except (OSError, subprocess.SubprocessError, ValueError):
        return {}


def print_rollup(rows, jobs, out):
    counts = {}
    for r in rows:
        key = (r["pdy"], r["cycle"])
        counts.setdefault(key, {}).setdefault(r["node_state"], 0)
        counts[key][r["node_state"]] += 1
        counts[key].setdefault("held", 0)
        counts[key]["held"] += int(r["held"])
    head = f"{'CYCLE':<16}{'TASKS':>7}  " + "  ".join(
        f"{STATE_WORD.get(s, s.upper()):>12}" for s in STATE_ORDER)
    print(head, file=out)
    print("-" * len(head), file=out)
    for (pdy, cyc), c in sorted(counts.items()):
        # Held is an overlay count and can overlap the underlying task-state counts.
        total = sum(c.get(s, 0) for s in STATE_ORDER)
        cells = "  ".join(f"{c.get(s, 0):>12}" for s in STATE_ORDER)
        susp = c.get("held", 0) + c.get("suspended", 0)
        line = f"{pdy + ' ' + cyc:<16}{total:>7}  {cells}"
        if susp:
            line += f"   (+{susp} held)"
        print(line, file=out)
    running = sum(1 for v in jobs.values() if v[0] == "RUNNING")
    print(f"\nbatch: {len(jobs)} job(s) in the queue, {running} running", file=out)


def print_tasks(rows, jobs, out):
    order = {s: i for i, s in enumerate(STATE_ORDER)}
    rows = sorted(rows, key=lambda r: (order.get(r["node_state"], 99), r["pdy"], r["cycle"], r["task"]))
    head = f"{'CYCLE':<16}{'TASK':<58}{'STATE':<18}{'TRY':>4}  {'CHANGED':<16}{'BATCH':<20}"
    print(head, file=out)
    print("-" * len(head), file=out)
    for r in rows:
        sj = slurm_for(r, jobs)
        task = r["task"] if len(r["task"]) <= 57 else "…" + r["task"][-56:]
        print(f"{r['pdy'] + ' ' + r['cycle']:<16}{task:<58}{display_state(r):<18}{r['try']:>4}  "
              f"{r['changed']:<16}{sj:<20}", file=out)
        if r["log"]:
            print(f"{'':<16}log: {r['log']}", file=out)
    print(f"\n{len(rows)} task(s)", file=out)


def slurm_for(r, jobs):
    """The Slurm state of this task's job, matched on the job name the ecf card builds.

    The cards name jobs <task without the leading j>_<cycle>, so match that exactly; a prefix
    match would pair a task with the same job in another cycle.
    """
    name = r["task"].rsplit("/", 1)[-1].replace("jrrfs_", "rrfs_")
    jstate = jobs.get(f"{name}_{r['cycle'][:2]}")
    return f"{jstate[0]} {jstate[1]}" if jstate else ""


def word_for(r):
    """The rocotostat-style word for a task, or SET-ASIDE for one completed without running."""
    if r["aside"] and r["node_state"] == "complete":
        return "SET-ASIDE"
    return STATE_WORD.get(r["node_state"], r["node_state"].upper())


def display_state(r):
    """Show the task state and mark a hold inherited from a suspended ancestor."""
    state = word_for(r)
    return f"{state} (HELD)" if r["held"] else state


def write_report(rows, jobs, directory, total):
    """Write stat, RUN and DEAD, the way the Rocoto workflow's stat script does.

    stat  the full per-cycle listing (what --workflow prints)
    RUN   what is moving: running, submitted and queued tasks, then a count of every state
    DEAD  what needs a look: failed and unknown tasks, with their counts
    TASKS what this configuration runs at all, by type and by cycle (what --plan prints)
    """
    counts = {}
    for r in rows:
        w = word_for(r)
        counts[w] = counts.get(w, 0) + 1
    held_count = sum(1 for r in rows if r["held"])
    line = lambda r: f"{r['pdy']} {r['cycle']}  {r['task']}  {display_state(r)}"

    with open(os.path.join(directory, "stat"), "w") as f:
        print_workflow(rows, jobs, f)

    with open(os.path.join(directory, "TASKS"), "w") as f:
        print_plan(rows, jobs, f, total)

    with open(os.path.join(directory, "RUN"), "w") as f:
        print("----------", file=f)
        for w in ("RUNNING", "BATCH QUEUED", "READY"):
            for r in rows:
                if word_for(r) == w:
                    print(line(r), file=f)
        for w in ("DONE", "RUNNING", "BATCH QUEUED", "READY", "FAILED", "HELD", "SET-ASIDE", "UNKNOWN"):
            # Held tasks are also counted under their underlying state above.
            n = held_count + counts.get("HELD", 0) if w == "HELD" else counts.get(w, 0)
            print(f"#{w.title() + ':':<15}{n}", file=f)
        print(time.strftime("%a %b %d %H:%M:%S %Z %Y"), file=f)

    with open(os.path.join(directory, "DEAD"), "w") as f:
        print("----------", file=f)
        for w in ("FAILED", "UNKNOWN"):
            for r in rows:
                if word_for(r) == w:
                    print(line(r), file=f)
                    if r["log"]:
                        print(f"  log: {r['log']}", file=f)
        print(f"#Failed:  {counts.get('FAILED', 0)}", file=f)
        print(f"#Unknown: {counts.get('UNKNOWN', 0)}", file=f)
    return counts


def task_type(name):
    """Collapse the member and forecast-hour parts of a task name, so a census stays readable."""
    name = re.sub(r"_mem\d+", "_mem*", name)
    name = re.sub(r"_f\d{3}_\d\d_\d\d", "_f*", name)
    name = re.sub(r"_f\d+(?![\w])", "_f*", name)
    name = re.sub(r"_(make_lbcs|save_restart_long)_\d+", r"_\1_*", name)
    return name


def print_plan(rows, jobs, out, total):
    """Every task this configuration runs, by type and then by cycle, with each one's state.

    What is printed is the work a retro day actually does.
    """
    print(f"{len(rows)} task(s) run per day, {total - len(rows)} of the {total} in the "
          "definition set aside by this configuration\n", file=out)

    census = {}
    for r in rows:
        key = task_type(r["task"].rsplit("/", 1)[-1])
        census.setdefault(key, {"n": 0, "cycles": set()})
        census[key]["n"] += 1
        census[key]["cycles"].add(r["cycle"])
    head = f"{'COUNT':>6}  {'TASK':<44}CYCLES"
    print(head, file=out)
    print("-" * (len(head) + 20), file=out)
    for name, c in sorted(census.items(), key=lambda kv: (-kv[1]["n"], kv[0])):
        cycles = sorted(c["cycles"])
        shown = " ".join(cycles) if len(cycles) <= 8 else f"{cycles[0]}-{cycles[-1]} ({len(cycles)})"
        print(f"{c['n']:>6}  {name:<44}{shown}", file=out)
    print("", file=out)
    print_workflow(rows, jobs, out)


def print_workflow(rows, jobs, out):
    """Every task in the order the workflow defines them, grouped by cycle, like rocotostat."""
    cycles = {}
    for r in rows:
        cycles.setdefault((r["pdy"], r["cycle"]), []).append(r)
    print("STATE: DONE complete, RUNNING active, BATCH QUEUED accepted by the scheduler and waiting "
          "to run,\n       READY eligible for ecFlow submission, FAILED aborted, HELD suspended; "
          "(HELD) marks a suspended ancestor, SET-ASIDE switched off by the configuration\n", file=out)
    for (pdy, cyc), items in cycles.items():
        counts = {}
        for r in items:
            counts[word_for(r)] = counts.get(word_for(r), 0) + 1
        summary = ", ".join(f"{n} {w.lower()}" for w, n in sorted(counts.items(), key=lambda kv: -kv[1]))
        held = sum(1 for r in items if r["held"]) + counts.get("HELD", 0)
        if held:
            summary += f" (+{held} held)"
        print(f"{pdy} {cyc}   {len(items)} tasks: {summary}", file=out)
        for r in items:
            word = display_state(r)
            task = r["task"] if len(r["task"]) <= 57 else "\u2026" + r["task"][-56:]
            print(f"  {task:<58}{word:<18}{r['try']:>4}  {r['changed']:<16}{slurm_for(r, jobs):<20}".rstrip(), file=out)
        print("", file=out)
    print(f"{len(rows)} task(s) in {len(cycles)} cycle(s)", file=out)


def main():
    p = argparse.ArgumentParser(description="state of the RRFS ecflow suite, rocotostat style")
    p.add_argument("--host", help="ecflow server host (default: ECF_HOST, then retro/config.sh)")
    p.add_argument("--port", help="ecflow server port (default: ECF_PORT)")
    p.add_argument("--suite", help="ecFlow suite (default: RRFS_SUITE, then retro/config.sh)")
    p.add_argument("-t", "--tasks", action="store_true", help="one line per task, not a rollup")
    p.add_argument("-w", "--workflow", action="store_true",
                   help="every task in workflow order, grouped by cycle (like rocotostat -c all)")
    p.add_argument("-p", "--plan", action="store_true",
                   help="every task this configuration runs, and its state (set-aside left out)")
    p.add_argument("-c", "--cycle", help="only these cycles, e.g. 03z or 00z,03z")
    p.add_argument("-s", "--state", help="only these states, e.g. aborted,active")
    p.add_argument("-a", "--all", action="store_true",
                   help="include day families the retro has not released yet")
    p.add_argument("--set-aside", action="store_true",
                   help="also list tasks the configuration switched off, marked SET-ASIDE")
    p.add_argument("-o", "--out", help="write to this file instead of the terminal")
    p.add_argument("--report", nargs="?", const=".", metavar="DIR",
                   help="write stat, RUN and DEAD files into DIR (default: here)")
    p.add_argument("-l", "--loop", type=int, metavar="SECONDS", help="refresh until interrupted")
    a = p.parse_args()

    cfg_host, cfg_port, cfg_suite = settings_from_config()
    host = a.host or os.getenv("ECF_HOST") or cfg_host
    port = a.port or os.getenv("ECF_PORT") or cfg_port or default_port()
    suite = a.suite or os.getenv("RRFS_SUITE") or cfg_suite or DEFAULT_SUITE
    if not host or not port:
        sys.exit("ERROR: no ecflow server; pass --host and --port or set ECF_HOST/ECF_PORT")
    cycles = set(a.cycle.split(",")) if a.cycle else None
    states = set(a.state.split(",")) if a.state else None

    while True:
        ci = ecflow.Client(str(host), str(port))
        ci.set_retry_connection_period(1)
        ci.set_connection_attempts(1)
        try:
            ci.sync_local()
        except RuntimeError:
            sys.exit(f"rrfsstat: no ecflow server is answering on {host}:{port}.\n"
                     "  Start one first (step C on the run instructions), or, if yours runs on a\n"
                     "  different port, pass --port <port>. The ecflow module sets ECF_PORT to\n"
                     "  your default, 1500 + your uid.")
        defs = ci.get_defs()
        if defs is None or defs.find_suite(suite) is None:
            sys.exit(f"rrfsstat: the server on {host}:{port} is running but has no /{suite} suite loaded "
                     "yet (step D on the run instructions).")
        # the plan is about the configuration rather than today's progress, so it covers the
        # day families the retro has not reached yet as well
        rows = collect(defs, suite, cycles, states, a.all or a.plan)
        total = len(rows)
        if not a.set_aside:
            # Switched-off tasks stay complete so their dependencies work; hide them by default
            # because a simplified retro may have thousands. --set-aside lists them all.
            rows = [r for r in rows if not r["aside"]]
        jobs = slurm_jobs()
        if a.report:
            counts = write_report(rows, jobs, a.report, total)
            print(f"wrote stat, RUN and DEAD in {os.path.abspath(a.report)}: "
                  + ", ".join(f"{n} {w.lower()}" for w, n in sorted(counts.items(), key=lambda kv: -kv[1])))
            if not a.loop:
                break
            time.sleep(a.loop)
            continue
        out = open(a.out, "w") if a.out else sys.stdout
        try:
            print(f"suite /{a.suite} on {host}:{port}   {time.strftime('%Y-%m-%d %H:%M:%S')}\n", file=out)
            if a.plan:
                print_plan(rows, jobs, out, total)
            elif a.workflow:
                print_workflow(rows, jobs, out)
            elif a.tasks:
                print_tasks(rows, jobs, out)
            else:
                print_rollup(rows, jobs, out)
        finally:
            if a.out:
                out.close()
        if not a.loop:
            break
        time.sleep(a.loop)


if __name__ == "__main__":
    main()
